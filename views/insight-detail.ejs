<%- include('partials/head', { title: article.title, description: article.summary }) %>
<%- include('partials/nav') %>

<main class="flex-grow bg-white">
  
  <!-- Breadcrumb & Reader Navigation -->
  <div class="border-b border-brand-linen bg-brand-cream/50 py-4">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 flex items-center justify-between text-xs text-brand-slateLight">
      <a href="/insights" class="inline-flex items-center text-brand-navy hover:text-brand-gold font-bold transition-colors">
        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        <span>All Partner Letters</span>
      </a>
      <div class="flex items-center space-x-3">
        <button onclick="window.print()" class="hidden sm:inline-flex items-center text-brand-slateLight hover:text-brand-navy transition-colors font-medium">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
          <span>Print / PDF</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Editorial Article Container -->
  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
    
    <!-- Meta Info Strip -->
    <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-brand-slateLight uppercase tracking-wider mb-6">
      <span class="px-2.5 py-1 rounded bg-brand-cream border border-brand-linen text-brand-navy font-semibold"><%= article.category %></span>
      <span>&middot;</span>
      <span><%= article.displayDate || article.date || 'Publication' %></span>
      <span>&middot;</span>
      <span><%= article.readTime || '4 Min Read' %></span>
    </div>

    <!-- Title -->
    <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-brand-navy leading-tight mb-6">
      <%= article.title %>
    </h1>

    <!-- Summary / Lead Box -->
    <div class="p-6 rounded-2xl bg-brand-cream border border-brand-linen mb-10 text-brand-ink text-sm sm:text-base leading-relaxed italic border-l-4 border-l-brand-gold">
      <%= article.summary %>
    </div>

    <!-- Article Body (Formatted Clean Editorial Typography) -->
    <div class="prose prose-brand max-w-none text-brand-ink text-sm sm:text-base leading-relaxed space-y-6">
      <%- article.body %>
    </div>

    <!-- Interactive Engagement & Sharing Bar -->
    <div class="mt-12 pt-8 border-t border-brand-linen flex flex-col sm:flex-row items-center justify-between gap-4">
      
      <!-- Like Button -->
      <button id="like-btn" data-id="<%= article.id %>" class="inline-flex items-center space-x-2 px-4 py-2 rounded-full border border-brand-linen bg-brand-cream hover:bg-brand-gold/10 text-brand-navy text-xs font-bold transition-all">
        <svg class="w-4 h-4 text-rose-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/></svg>
        <span>Approve Insights (<span id="like-count"><%= article.likes || 0 %></span>)</span>
      </button>

      <!-- Share Actions -->
      <div class="flex items-center space-x-2 text-xs font-semibold text-brand-slate">
        <button onclick="navigator.clipboard.writeText(window.location.href); alert('Letter link copied to clipboard');" class="inline-flex items-center space-x-1.5 px-3.5 py-1.5 rounded-full border border-brand-linen bg-white hover:bg-brand-cream transition-colors text-brand-navy">
          <svg class="w-3.5 h-3.5 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
          <span>Copy Article Link</span>
        </button>
      </div>

    </div>

    <!-- Committee Attribution Box -->
    <div class="mt-10 p-6 rounded-2xl bg-brand-navy text-white flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <h4 class="font-serif text-lg font-bold text-brand-gold">Flourish Investment Committee</h4>
        <p class="text-xs text-brand-slateLight mt-1">General Partner Desk &middot; 22-Year Cross-Cycle Experience</p>
      </div>
      <a href="/contact" class="px-4 py-2 rounded-full bg-brand-gold text-brand-navy font-bold text-xs uppercase tracking-wider hover:bg-brand-goldLight transition-colors shrink-0">
        Direct Inquiries &rarr;
      </a>
    </div>

  </article>

</main>

<script>
  // Simple AJAX Like handler
  const likeBtn = document.getElementById('like-btn');
  if (likeBtn) {
    likeBtn.addEventListener('click', async () => {
      const articleId = likeBtn.dataset.id;
      try {
        const res = await fetch(`/api/articles/${articleId}/like`, { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          document.getElementById('like-count').textContent = data.likes;
        }
      } catch (err) {
        console.error('Like error:', err);
      }
    });
  }
</script>

<%- include('partials/footer') %>
