<%- include('partials/head', { title: article.title, description: article.summary }) %>
<%- include('partials/nav') %>

<main class="flex-grow bg-white">
  
  <!-- Breadcrumb & Reader Navigation -->
  <div class="border-b border-brand-linen bg-brand-cream/50 py-4">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 flex items-center justify-between text-xs text-brand-slateLight">
      <a href="/insights" class="inline-flex items-center text-brand-navy hover:text-brand-gold font-bold transition-colors">
        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        <span>All Monthly Letters</span>
      </a>
      <div class="flex items-center space-x-3">
        <button onclick="window.print()" class="hidden sm:inline-flex items-center text-brand-slateLight hover:text-brand-navy transition-colors font-medium">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
          <span>Print / PDF</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Editorial Article Container -->
  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
    
    <!-- Executive Letterhead with Official Flourish Management Logo -->
    <div class="flex items-center justify-between pb-6 border-b border-brand-linen mb-8">
      <div class="flex items-center space-x-3.5">
        <a href="/" class="shrink-0 block group">
          <img src="/logo.png" alt="Flourish Management Logo" class="h-10 sm:h-12 w-auto object-contain transition-transform group-hover:scale-105">
        </a>
        <div>
          <span class="font-serif text-sm sm:text-base font-bold text-brand-navy tracking-wider uppercase block">Flourish Management</span>
          <span class="text-[10px] font-mono text-brand-slateLight tracking-widest uppercase block">Monthly Partner Letter &middot; Investment Committee Directive</span>
        </div>
      </div>
      <div class="hidden sm:block text-right">
        <span class="text-[10px] font-mono font-semibold text-brand-gold uppercase tracking-widest px-3 py-1 rounded-full bg-brand-cream border border-brand-linen">
          <%= article.category %> Desk
        </span>
      </div>
    </div>

    <!-- Meta Info Strip -->
    <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-brand-slateLight uppercase tracking-wider mb-6">
      <span class="px-2.5 py-1 rounded bg-brand-cream border border-brand-linen text-brand-navy font-semibold"><%= article.category %></span>
      <span>&middot;</span>
      <span><%= article.displayDate || article.date || 'Publication' %></span>
      <span>&middot;</span>
      <span><%= article.readTime || '4 Min Read' %></span>
    </div>

    <!-- Title -->
    <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-brand-navy leading-tight mb-6">
      <%= article.title %>
    </h1>

    <!-- Summary / Lead Box -->
    <div class="p-6 rounded-2xl bg-brand-cream border border-brand-linen mb-10 text-brand-ink text-sm sm:text-base leading-relaxed italic border-l-4 border-l-brand-gold">
      <%= article.summary %>
    </div>

    <!-- Article Body (Formatted Clean Editorial Typography) -->
    <div class="prose prose-brand max-w-none text-brand-ink text-sm sm:text-base leading-relaxed space-y-6">
      <%- article.body %>
    </div>

    <!-- How Flourish Adopts This Best Practice -->
    <% if (article.flourishAdoption) { %>
    <div class="my-10 p-6 sm:p-7 rounded-2xl bg-brand-cream border border-brand-linen/90 shadow-sm flex flex-col sm:flex-row items-start gap-4">
      <div class="w-11 h-11 rounded-xl bg-white border border-brand-linen flex items-center justify-center shrink-0 p-1.5 shadow-xs">
        <img src="/logo.png" alt="Flourish Management Logo" class="w-full h-full object-contain">
      </div>
      <div class="space-y-1.5 flex-1">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-[10px] font-mono uppercase tracking-widest font-bold text-brand-gold">Flourish Execution Standard</span>
          <span class="text-brand-slateLight">&middot;</span>
          <span class="text-[10px] font-mono text-brand-slateLight uppercase">Principal Portfolio Implementation</span>
        </div>
        <h3 class="font-serif text-base sm:text-lg font-bold text-brand-navy">How Flourish Adopts This Best Practice</h3>
        <p class="text-xs sm:text-sm text-brand-ink leading-relaxed font-sans">
          <%= article.flourishAdoption %>
        </p>
      </div>
    </div>
    <% } %>

    <!-- Interactive Engagement & Sharing Bar -->
    <div class="mt-12 pt-8 border-t border-brand-linen flex flex-col sm:flex-row items-center justify-between gap-4">
      
      <!-- Like Button -->
      <button id="like-btn" data-id="<%= article.id %>" class="inline-flex items-center space-x-2 px-4 py-2 rounded-full border border-brand-linen bg-brand-cream hover:bg-brand-gold/10 text-brand-navy text-xs font-bold transition-all">
        <svg class="w-4 h-4 text-rose-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/></svg>
        <span>Approve Insights (<span id="like-count"><%= article.likes || 0 %></span>)</span>
      </button>

      <!-- Share Actions -->
      <div class="flex items-center space-x-2 text-xs font-semibold text-brand-slate">
        <button onclick="navigator.clipboard.writeText(window.location.href); alert('Letter link copied to clipboard');" class="inline-flex items-center space-x-1.5 px-3.5 py-1.5 rounded-full border border-brand-linen bg-white hover:bg-brand-cream transition-colors text-brand-navy">
          <svg class="w-3.5 h-3.5 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
          <span>Copy Article Link</span>
        </button>
      </div>

    </div>

    <!-- Committee Attribution Box with Logo -->
    <div class="mt-10 p-6 sm:p-7 rounded-2xl bg-brand-navy text-white flex flex-col sm:flex-row items-center justify-between gap-5 border border-brand-gold/20 shadow-md">
      <div class="flex items-center space-x-4">
        <img src="/logo.png" alt="Flourish Management Logo" class="h-11 w-auto object-contain brightness-0 invert opacity-95 shrink-0">
        <div>
          <h4 class="font-serif text-lg font-bold text-brand-gold">Flourish Investment Committee</h4>
          <p class="text-xs text-brand-slateLight mt-0.5">General Partner Desk &middot; Flourish Management LLC</p>
        </div>
      </div>
      <a href="/contact" class="px-5 py-2.5 rounded-full bg-brand-gold text-brand-navy font-bold text-xs uppercase tracking-wider hover:bg-brand-goldLight transition-colors shrink-0 shadow-sm">
        Direct Inquiries &rarr;
      </a>
    </div>

    <!-- Monthly Subscription Card -->
    <div class="mt-12 bg-brand-cream border border-brand-linen rounded-3xl p-8 sm:p-10 shadow-sm text-center">
      <div class="max-w-xl mx-auto space-y-4">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-white border border-brand-linen text-[11px] font-mono uppercase tracking-widest text-brand-gold">
          <svg class="w-3.5 h-3.5 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          <span>Direct Monthly Dispatch</span>
        </div>
        <h3 class="font-serif text-2xl text-brand-navy font-bold">Subscribe to Monthly Partner Letters</h3>
        <p class="text-xs text-brand-inkMuted leading-relaxed">
          Receive our investment committee's monthly research letters, portfolio stress-test reports, and direct underwriting frameworks delivered once each month.
        </p>
        <form id="newsletter-form" class="flex flex-col sm:flex-row gap-3 pt-2 max-w-md mx-auto">
          <input type="email" id="newsletter-email" placeholder="Your executive email address" required
                 class="flex-1 px-4 py-3 rounded-full border border-brand-linen bg-white text-brand-navy text-xs focus:outline-none focus:ring-2 focus:ring-brand-gold/40 focus:border-brand-gold transition-all placeholder:text-brand-slateLight">
          <button type="submit" id="newsletter-submit" 
                  class="px-6 py-3 bg-brand-navy text-white text-xs font-semibold uppercase tracking-wider rounded-full hover:bg-brand-navyLight border border-brand-navy transition-all shrink-0 shadow-sm">
            Subscribe
          </button>
        </form>
        <div id="newsletter-message" class="text-xs font-semibold hidden transition-all mt-3"></div>
        <p class="text-[11px] text-brand-slateLight pt-1">
          Sent once each month. Direct 1-click unsubscribe included in every email. No spam.
        </p>
      </div>
    </div>

  </article>

</main>

<script>
  // Simple AJAX Like handler
  const likeBtn = document.getElementById('like-btn');
  if (likeBtn) {
    likeBtn.addEventListener('click', async () => {
      const articleId = likeBtn.dataset.id;
      try {
        const res = await fetch(`/api/articles/${articleId}/like`, { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          document.getElementById('like-count').textContent = data.likes;
        }
      } catch (err) {
        console.error('Like error:', err);
      }
    });
  }
</script>

<%- include('partials/footer') %>
