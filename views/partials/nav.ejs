<!-- Top Header & Navigation Bar (Brand Midnight Navy & Warm Gold) -->
<header class="sticky top-0 z-40 bg-brand-navy border-b border-brand-navyLight shadow-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Logo & Brand Identity -->
      <a href="/" class="flex items-center space-x-3 group">
        <img src="/logo.png" alt="Flourish Management" class="h-10 w-auto object-contain transition-transform duration-300 group-hover:scale-105" />
        <div class="hidden sm:block border-l border-brand-navyLight pl-3">
          <span class="block text-xs uppercase tracking-[0.25em] text-brand-gold font-medium">Syndicate</span>
          <span class="block text-[10px] uppercase tracking-wider text-brand-slateLight">Est. 2004</span>
        </div>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden lg:flex items-center space-x-1 xl:space-x-2 text-xs uppercase tracking-wider font-medium">
        <a href="/" class="px-3 py-2 border-b-2 transition-colors <%= currentPath === '/' ? 'text-white border-brand-gold font-semibold' : 'text-brand-cream/80 border-transparent hover:text-brand-gold hover:border-brand-gold/40' %>">
          Overview
        </a>
        <a href="/strategies" class="px-3 py-2 border-b-2 transition-colors <%= currentPath === '/strategies' ? 'text-white border-brand-gold font-semibold' : 'text-brand-cream/80 border-transparent hover:text-brand-gold hover:border-brand-gold/40' %>">
          Strategies
        </a>
        <a href="/track-record" class="px-3 py-2 border-b-2 transition-colors <%= currentPath === '/track-record' ? 'text-white border-brand-gold font-semibold' : 'text-brand-cream/80 border-transparent hover:text-brand-gold hover:border-brand-gold/40' %>">
          Track Record
        </a>
        <a href="/diligence" class="px-3 py-2 border-b-2 transition-colors <%= currentPath === '/diligence' ? 'text-white border-brand-gold font-semibold' : 'text-brand-cream/80 border-transparent hover:text-brand-gold hover:border-brand-gold/40' %>">
          Tear-Sheets
        </a>
        <a href="/insights" class="px-3 py-2 border-b-2 transition-colors <%= currentPath.startsWith('/insights') ? 'text-white border-brand-gold font-semibold' : 'text-brand-cream/80 border-transparent hover:text-brand-gold hover:border-brand-gold/40' %>">
          Insights
        </a>
        <a href="/contact" class="ml-4 inline-flex items-center px-4 py-2 rounded-full border border-brand-gold text-brand-gold hover:bg-brand-gold hover:text-brand-navy transition-colors font-semibold shadow-sm">
          <span>Inquire & Co-Invest</span>
          <svg class="w-3.5 h-3.5 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </nav>

      <!-- Mobile Hamburger Button (48px Touch Target) -->
      <div class="flex lg:hidden items-center">
        <button id="mobile-menu-btn" type="button" aria-label="Toggle Navigation Menu" class="p-3 rounded-lg text-brand-gold hover:text-white hover:bg-brand-navyLight focus:outline-none focus:ring-2 focus:ring-brand-gold">
          <svg id="menu-icon-bars" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu (Full width, Midnight Navy, Large touch targets) -->
  <div id="mobile-menu" class="hidden lg:hidden bg-brand-navyLight border-t border-brand-navySoft px-4 pt-3 pb-6 space-y-2 text-sm uppercase tracking-wider">
    <a href="/" class="block px-4 py-3 rounded-md transition-colors <%= currentPath === '/' ? 'bg-brand-navy text-brand-gold font-bold border-l-4 border-brand-gold' : 'text-brand-cream/85 hover:bg-brand-navy hover:text-white' %>">
      Overview
    </a>
    <a href="/strategies" class="block px-4 py-3 rounded-md transition-colors <%= currentPath === '/strategies' ? 'bg-brand-navy text-brand-gold font-bold border-l-4 border-brand-gold' : 'text-brand-cream/85 hover:bg-brand-navy hover:text-white' %>">
      Strategies
    </a>
    <a href="/track-record" class="block px-4 py-3 rounded-md transition-colors <%= currentPath === '/track-record' ? 'bg-brand-navy text-brand-gold font-bold border-l-4 border-brand-gold' : 'text-brand-cream/85 hover:bg-brand-navy hover:text-white' %>">
      Track Record (2004–2026)
    </a>
    <a href="/diligence" class="block px-4 py-3 rounded-md transition-colors <%= currentPath === '/diligence' ? 'bg-brand-navy text-brand-gold font-bold border-l-4 border-brand-gold' : 'text-brand-cream/85 hover:bg-brand-navy hover:text-white' %>">
      Diligence Tear-Sheets
    </a>
    <a href="/insights" class="block px-4 py-3 rounded-md transition-colors <%= currentPath.startsWith('/insights') ? 'bg-brand-navy text-brand-gold font-bold border-l-4 border-brand-gold' : 'text-brand-cream/85 hover:bg-brand-navy hover:text-white' %>">
      Quarterly Insights
    </a>
    <div class="pt-2">
      <a href="/contact" class="block text-center w-full px-5 py-3 rounded-full bg-brand-gold text-brand-navy font-bold text-xs uppercase tracking-wider hover:bg-brand-goldLight transition-colors">
        Direct Desk / Inquiries &rarr;
      </a>
    </div>
  </div>
</header>
