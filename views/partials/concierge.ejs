<!-- Flourish Syndicate Concierge Floating Desk (Brand-Harmonized) -->
<button id="chat-toggle" class="fixed bottom-6 right-6 z-40 bg-brand-navy hover:bg-brand-navyLight text-brand-gold p-4 rounded-full shadow-2xl border border-brand-gold/50 transition-all duration-300 transform hover:scale-105 group focus:outline-none focus:ring-2 focus:ring-brand-gold" aria-label="Open Syndicate Concierge">
  <!-- Chat Desk Icon -->
  <svg class="w-6 h-6 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
  </svg>
  <!-- Notification Badge -->
  <span id="chat-notification" class="hidden absolute top-0 right-0 w-3.5 h-3.5 bg-brand-gold rounded-full border-2 border-brand-navy animate-ping"></span>
</button>

<!-- Interactive Chat Container (Responsive: Mobile Full-Width Bottom Sheet / Desktop Clean Card) -->
<div id="chat-container" class="hidden fixed inset-x-2 bottom-20 sm:inset-auto sm:bottom-24 sm:right-6 z-50 w-auto sm:w-[400px] h-[520px] max-h-[85vh] bg-white rounded-2xl sm:rounded-3xl border border-brand-linen shadow-2xl flex flex-col overflow-hidden transition-all duration-300">
  
  <!-- Header -->
  <div class="bg-brand-navy text-white p-4 flex items-center justify-between border-b border-brand-navyLight">
    <div class="flex items-center space-x-3">
      <div class="relative">
        <div class="w-9 h-9 bg-brand-navyLight border border-brand-gold/40 rounded-full flex items-center justify-center font-serif font-bold text-brand-gold">F</div>
        <div class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-emerald-400 rounded-full border-2 border-brand-navy animate-pulse"></div>
      </div>
      <div>
        <h4 class="text-sm font-serif font-bold tracking-wide text-white">Flourish Syndicate Concierge</h4>
        <p class="text-[10px] text-brand-goldLight font-medium">General Partner Desk &middot; 20-Yr Committee</p>
      </div>
    </div>
    
    <button id="close-chat" class="text-brand-slateLight hover:text-white p-1 focus:outline-none" aria-label="Close Concierge">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Sub-Ribbon Context -->
  <div class="bg-[#070F21] px-4 py-1.5 text-[9px] font-mono tracking-wider uppercase text-brand-slateLight flex items-center justify-between border-b border-white/5">
    <span>Cross-Cycle Knowledge Engine</span>
    <span class="text-brand-gold">2004 – 2026</span>
  </div>

  <!-- Messages Scroll Area -->
  <div id="chat-messages" class="flex-1 p-4 overflow-y-auto space-y-3 bg-brand-creamPaper">
    <!-- Typing Indicator Bubble -->
    <div id="typing-indicator" class="hidden flex justify-start mb-3">
      <div class="bg-brand-cream text-brand-ink rounded-2xl rounded-bl-none px-4 py-2 border border-brand-linen shadow-sm flex items-center space-x-1.5">
        <div class="w-2 h-2 bg-brand-slateLight rounded-full animate-bounce"></div>
        <div class="w-2 h-2 bg-brand-slateLight rounded-full animate-bounce [animation-delay:0.2s]"></div>
        <div class="w-2 h-2 bg-brand-slateLight rounded-full animate-bounce [animation-delay:0.4s]"></div>
      </div>
    </div>
  </div>

  <!-- Quick Shortcut Buttons (Clicking resets state so users are never trapped) -->
  <div class="px-3 py-2 bg-brand-cream border-t border-brand-linen/60 flex flex-wrap gap-1.5 text-[10px] font-medium text-brand-ink">
    <button data-question="What are your real estate underwriting rules?" class="chat-shortcut-btn bg-white hover:bg-brand-cream border border-brand-linen rounded-full px-2.5 py-1 transition-colors">🏢 Real Estate</button>
    <button data-question="Explain your options hedging strategy" class="chat-shortcut-btn bg-white hover:bg-brand-cream border border-brand-linen rounded-full px-2.5 py-1 transition-colors">📈 Options Hedging</button>
    <button data-question="What is your 20-year cross-cycle track record?" class="chat-shortcut-btn bg-white hover:bg-brand-cream border border-brand-linen rounded-full px-2.5 py-1 transition-colors">📜 20-Yr Record</button>
    <button data-question="Show me your diligence tear-sheets" class="chat-shortcut-btn bg-white hover:bg-brand-cream border border-brand-linen rounded-full px-2.5 py-1 transition-colors">📑 Tear-Sheets</button>
    <button data-question="I want to pitch a seed stage startup" class="chat-shortcut-btn bg-white hover:bg-brand-cream border border-brand-linen rounded-full px-2.5 py-1 transition-colors">🚀 Founder Pitch</button>
    <button data-question="How can an accredited allocator co-invest with you?" class="chat-shortcut-btn bg-white hover:bg-brand-cream border border-brand-linen rounded-full px-2.5 py-1 transition-colors">💼 Allocator Inquiries</button>
  </div>

  <!-- Message Input Form -->
  <form id="chat-form" class="p-3 bg-white border-t border-brand-linen flex items-center space-x-2">
    <input type="text" id="chat-input" placeholder="Inquire with committee desk..." class="flex-1 text-sm bg-brand-cream border border-brand-linen focus:border-brand-gold focus:outline-none rounded-full px-4 py-2.5 transition-colors">
    <button type="submit" class="bg-brand-navy hover:bg-brand-navyLight border border-brand-gold/60 text-brand-gold p-2.5 rounded-full shadow-sm transition-colors focus:outline-none" aria-label="Send Message">
      <svg class="w-4 h-4 transform rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
      </svg>
    </button>
  </form>
</div>
