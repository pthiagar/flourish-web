<%- include('partials/head', { title: 'Monthly Partner Letters', description: 'Executive research letters and underwriting memos from the Flourish Management Investment Committee.' }) %>
<%- include('partials/nav') %>

<main class="flex-grow">
  
  <!-- Header Banner -->
  <section class="bg-brand-navy text-white py-16 sm:py-20 border-b border-brand-navyLight">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-brand-navyLight border border-brand-gold/40 text-xs font-mono uppercase tracking-widest text-brand-gold mb-4">
          <span>Investment Committee Publications</span>
        </div>
        <h1 class="font-serif text-3xl sm:text-5xl font-bold leading-tight mb-4">
          Monthly Partner Letters & Underwriting Memos
        </h1>
        <p class="text-sm sm:text-base text-brand-slateLight leading-relaxed">
          Prescriptive, battle-tested underwriting insights and macro frameworks published monthly across market cycles by our investment committee.
        </p>
      </div>
    </div>
  </section>

  <!-- Filter & Article Grid Section -->
  <section class="py-12 sm:py-16 bg-brand-cream border-b border-brand-linen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Filter & Scope Controls -->
      <div class="bg-white rounded-2xl p-5 sm:p-6 border border-brand-linen mb-10 shadow-sm space-y-4">
        <!-- Top Row: Timeframe / Scope Selection -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-brand-linen/70">
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-xs uppercase tracking-wider text-brand-inkMuted font-bold mr-1">Timeframe:</span>
            <!-- Last 3 Months (Default) -->
            <a href="/insights<%= selectedCategory ? '?category=' + encodeURIComponent(selectedCategory) : '' %>" 
               class="px-4 py-2 rounded-full text-xs font-semibold transition-all inline-flex items-center <%= !isAllView ? 'bg-brand-navy text-brand-gold shadow-sm' : 'bg-brand-cream text-brand-ink border border-brand-linen hover:border-brand-gold' %>">
              <span>Last 3 Months (Default)</span>
              <span class="ml-2 px-2 py-0.5 text-[10px] rounded-full <%= !isAllView ? 'bg-brand-navyLight text-brand-gold font-bold' : 'bg-white text-brand-slateLight' %>"><%= recentCount %></span>
            </a>
            <!-- All Publications Selection -->
            <a href="/insights?view=all<%= selectedCategory ? '&category=' + encodeURIComponent(selectedCategory) : '' %>" 
               class="px-4 py-2 rounded-full text-xs font-semibold transition-all inline-flex items-center <%= isAllView ? 'bg-brand-navy text-brand-gold shadow-sm' : 'bg-brand-cream text-brand-ink border border-brand-linen hover:border-brand-gold' %>">
              <span>All Publications</span>
              <span class="ml-2 px-2 py-0.5 text-[10px] rounded-full <%= isAllView ? 'bg-brand-navyLight text-brand-gold font-bold' : 'bg-white text-brand-slateLight' %>"><%= totalCount %></span>
            </a>
          </div>

          <!-- Context Horizon Label -->
          <div class="text-xs text-brand-slateLight font-mono flex items-center">
            <span class="w-2.5 h-2.5 rounded-full <%= isAllView ? 'bg-brand-gold' : 'bg-emerald-500' %> mr-2 inline-block"></span>
            <%= isAllView ? 'Showing Complete Historical Catalog (Jan 2026 – Present)' : 'Default View: Latest 3 Months (July – September 2026)' %>
          </div>
        </div>

        <!-- Bottom Row: Discipline Filter Pills -->
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-xs uppercase tracking-wider text-brand-inkMuted font-bold mr-1">Discipline:</span>
          <a href="/insights<%= isAllView ? '?view=all' : '' %>" 
             class="px-3.5 py-1.5 rounded-full text-xs font-semibold transition-colors <%= !selectedCategory ? 'bg-brand-navy text-white' : 'bg-white text-brand-ink border border-brand-linen hover:border-brand-gold' %>">
            All Disciplines
          </a>
          <a href="/insights?category=real-estate<%= isAllView ? '&view=all' : '' %>" 
             class="px-3.5 py-1.5 rounded-full text-xs font-semibold transition-colors <%= (selectedCategory === 'real-estate' || selectedCategory === 'realestate' || selectedCategory === 'real') ? 'bg-brand-navy text-white' : 'bg-white text-brand-ink border border-brand-linen hover:border-brand-gold' %>">
            Physical Real Estate
          </a>
          <a href="/insights?category=macro<%= isAllView ? '&view=all' : '' %>" 
             class="px-3.5 py-1.5 rounded-full text-xs font-semibold transition-colors <%= (selectedCategory === 'macro' || selectedCategory === 'options' || selectedCategory === 'options-macro') ? 'bg-brand-navy text-white' : 'bg-white text-brand-ink border border-brand-linen hover:border-brand-gold' %>">
            Options & Macro
          </a>
          <a href="/insights?category=venture<%= isAllView ? '&view=all' : '' %>" 
             class="px-3.5 py-1.5 rounded-full text-xs font-semibold transition-colors <%= (selectedCategory === 'venture' || selectedCategory === 'vc' || selectedCategory === 'venture-capital') ? 'bg-brand-navy text-white' : 'bg-white text-brand-ink border border-brand-linen hover:border-brand-gold' %>">
            Seed Venture
          </a>
        </div>
      </div>

      <!-- Articles Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% if (articles && articles.length > 0) { %>
          <% articles.forEach(function(article) { %>
          <article class="bg-white rounded-2xl p-6 border border-brand-linen shadow-sm flex flex-col justify-between card-hover">
            <div>
              <div class="flex items-center justify-between text-[11px] font-mono text-brand-slateLight uppercase tracking-wider mb-3">
                <div class="flex items-center space-x-1.5">
                  <img src="/logo.png" alt="Flourish" class="w-3.5 h-3.5 object-contain opacity-85">
                  <span><%= article.displayDate || article.date || 'Publication' %></span>
                </div>
                <span class="px-2 py-0.5 rounded bg-brand-cream border border-brand-linen text-brand-navy font-semibold"><%= article.category %></span>
              </div>
              <h3 class="font-serif text-lg font-bold text-brand-navy mb-2 line-clamp-2">
                <a href="/insights/<%= article.id %>" class="hover:text-brand-gold transition-colors">
                  <%= article.title %>
                </a>
              </h3>
              <p class="text-xs text-brand-inkMuted leading-relaxed line-clamp-3 mb-6">
                <%= article.summary %>
              </p>
            </div>
            
            <div class="pt-4 border-t border-brand-linen/70 flex items-center justify-between text-xs font-semibold">
              <a href="/insights/<%= article.id %>" class="text-brand-navy hover:text-brand-gold inline-flex items-center">
                <span>Read Letter &rarr;</span>
              </a>
              <span class="text-[10px] text-brand-slateLight font-mono"><%= article.readTime || '4 Min Read' %></span>
            </div>
          </article>
          <% }); %>
        <% } else { %>
          <div class="col-span-3 text-center py-12 bg-white rounded-2xl border border-brand-linen text-brand-inkMuted text-sm">
            <p class="mb-3">No partner letters found for the selected filter.</p>
            <a href="/insights" class="inline-flex items-center text-xs font-semibold text-brand-navy hover:text-brand-gold">
              &larr; Reset to Default View (Last 3 Months)
            </a>
          </div>
        <% } %>
      </div>

      <!-- Subscribe to Monthly Partner Letters Form Card -->
      <div class="mt-16 bg-white border border-brand-linen rounded-3xl p-8 sm:p-12 shadow-sm text-center max-w-3xl mx-auto">
        <div class="max-w-xl mx-auto space-y-4">
          <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-brand-cream border border-brand-linen text-[11px] font-mono uppercase tracking-widest text-brand-gold">
            <svg class="w-3.5 h-3.5 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <span>Direct Investor Syndicate</span>
          </div>
          <h3 class="font-serif text-2xl sm:text-3xl text-brand-navy font-bold">Subscribe to Monthly Partner Letters</h3>
          <p class="text-xs sm:text-sm text-brand-inkMuted leading-relaxed">
            Join our distribution list to receive our investment committee's monthly research letters, portfolio stress-test reports, and direct underwriting frameworks delivered once each month.
          </p>
          <form id="newsletter-form" class="flex flex-col sm:flex-row gap-3 pt-2 max-w-md mx-auto">
            <input type="email" id="newsletter-email" placeholder="Your executive email address" required
                   class="flex-1 px-4 py-3 rounded-full border border-brand-linen bg-brand-cream text-brand-navy text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-brand-gold/40 focus:border-brand-gold transition-all placeholder:text-brand-slateLight">
            <button type="submit" id="newsletter-submit" 
                    class="px-6 py-3 bg-brand-navy text-white text-xs font-semibold uppercase tracking-wider rounded-full hover:bg-brand-navyLight border border-brand-navy transition-all shrink-0 shadow-sm">
              Subscribe
            </button>
          </form>
          <div id="newsletter-message" class="text-xs font-semibold hidden transition-all mt-3"></div>
          <p class="text-[11px] text-brand-slateLight pt-1">
            Sent once each month. Direct 1-click unsubscribe included in every email. No spam.
          </p>
        </div>
      </div>

    </div>
  </section>

</main>

<%- include('partials/footer') %>
